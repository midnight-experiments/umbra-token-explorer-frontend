# Copy to .env and adjust; `node --env-file=.env src/main.mjs` (or `docker run --env-file .env`) reads it.

# Where the server listens. Use 0.0.0.0 to accept connections from other hosts (the Docker image does).
HOST=127.0.0.1
PORT=10591

# Each network's UmbraDB module API (its `listen.api` address); the explorer calls
# <API>/token-metadata-api/v1/tokens. Set a variable to an empty value to turn that network off.
# Unset, PREPROD_API and PREVIEW_API default to 127.0.0.1:10540 and 127.0.0.1:10550; MAINNET_API is off.
PREPROD_API=http://127.0.0.1:10540
PREVIEW_API=http://127.0.0.1:10550
MAINNET_API=

# The network the page opens on (preprod when it is configured, else the first configured one).
# DEFAULT_NETWORK=preprod

# How long to wait for an indexer before answering 504.
# UPSTREAM_TIMEOUT_MS=15000
